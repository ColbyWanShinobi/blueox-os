#!/usr/bin/env bash
# Move this system to the newest signed BlueOx Redux image.
set -Eeuo pipefail

readonly IMAGE_REFERENCE='ostree-image-signed:docker://ghcr.io/colbywanshinobi/blueox-os:latest'

usage() {
  cat <<'EOF'
Usage: blueox-update [--reboot]

Rebase to the newest signed BlueOx OS image published on the latest channel.
Without --reboot, reboot manually after a new deployment is staged.
EOF
}

reboot_after_update=false
case "${1:-}" in
  '')
    ;;
  --reboot)
    reboot_after_update=true
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  *)
    printf 'error: unknown option: %s\n' "$1" >&2
    usage >&2
    exit 2
    ;;
esac

if (( EUID != 0 )); then
  exec sudo -- "$0" "$@"
fi

printf 'Checking for the newest signed BlueOx OS image...\n'
current_reference="$(
  rpm-ostree status --booted --json |
    jq -r '.deployments[] | select(.booted) | .["container-image-reference"] // empty'
)"

if [[ "$current_reference" == "$IMAGE_REFERENCE" ]]; then
  # `rebase` only switches origins.  Re-basing to the reference already in
  # use fails with “Old and new refs are equal”, even when its mutable tag has
  # a newer image.  `upgrade` follows that origin and stages its newest commit.
  rpm-ostree upgrade
else
  rpm-ostree rebase "$IMAGE_REFERENCE"
fi

if [[ "$reboot_after_update" == true ]]; then
  systemctl reboot
fi

printf '\nUpdate staged. Reboot to boot the new deployment.\n'
